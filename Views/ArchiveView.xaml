<UserControl x:Class="MediaConverter.Views.ArchiveView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource PrimaryTextBrush}" Loaded="View_Loaded">
 <UserControl.Resources>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
 </UserControl.Resources>
 <Grid Margin="22,16,22,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <TextBlock Text="圧縮・展開" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" Margin="0,0,0,14" />
  <Grid x:Name="OptionsPanel" Grid.Row="1" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="操作" Margin="0,0,0,6" /><ComboBox x:Name="ActionCombo" SelectedIndex="0" SelectionChanged="Options_Changed"><ComboBoxItem Content="圧縮する" /><ComboBoxItem Content="展開する" /></ComboBox></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="形式" Margin="0,0,0,6" /><ComboBox x:Name="FormatCombo" SelectedIndex="0" ToolTip="ZIPはWindowsや7-Zipと互換です。Ziper Fastは大容量ファイルをGPUで分割処理する専用形式です。"><ComboBoxItem Content="ZIP（互換形式）" /><ComboBoxItem Content="Ziper Fast（.ziper）" /></ComboBox></StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="処理方法" Margin="0,0,0,6" /><ComboBox x:Name="GpuCombo" SelectedIndex="0" ToolTip="GPUがない場合や処理に失敗した場合はCPUへ切り替わります。"><ComboBoxItem Content="自動" /><ComboBoxItem Content="GPU優先" /><ComboBoxItem Content="CPUのみ" /></ComboBox></StackPanel>
   <StackPanel Grid.Column="3"><TextBlock Text="圧縮レベル" Margin="0,0,0,6" /><ComboBox x:Name="LevelCombo" SelectedIndex="1"><ComboBoxItem Content="無圧縮" /><ComboBoxItem Content="速度優先" /><ComboBoxItem Content="標準" /><ComboBoxItem Content="圧縮率優先" /></ComboBox></StackPanel>
  </Grid>
  <DockPanel Grid.Row="2" x:Name="InputToolbar" Margin="0,0,0,10">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="選択を削除" Click="Remove_Click" /><Button Content="クリア" Click="Clear_Click" Margin="4,0,0,0" /></StackPanel>
   <StackPanel Orientation="Horizontal"><Button Content="ファイルを追加" Click="AddFiles_Click" Margin="0,0,8,0" /><Button Content="フォルダを追加" Click="AddFolder_Click" /><TextBlock x:Name="CountText" Text="0件" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" /></StackPanel>
  </DockPanel>
  <Border Grid.Row="3" x:Name="DropSurface" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource ControlBackgroundBrush}" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop" ToolTip="この一覧にファイル・フォルダをドロップできます。">
   <Grid>
    <ListBox x:Name="InputList" SelectionMode="Extended"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" /></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Text="ファイル・フォルダ" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=InputList, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
  </Border>
  <Grid Grid.Row="4" x:Name="DestinationPanel" Margin="0,12,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock Text="保存先" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" /><TextBox x:Name="OutputDirectoryBox" Grid.Column="1" /><Button Grid.Column="2" Content="参照..." Click="Browse_Click" Margin="8,0,0,0" />
  </Grid>
  <Grid Grid.Row="5">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock x:Name="GpuStatusText" Text="GPUを確認しています..." Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" /><TextBlock x:Name="StatusText" Text="準備完了" TextWrapping="Wrap" Margin="0,4,0,0" /><ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0" /></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="OpenResultButton" Content="保存先を開く" IsEnabled="False" Click="OpenResult_Click" /><Button x:Name="CancelButton" Content="キャンセル" IsEnabled="False" Click="Cancel_Click" /><Button x:Name="StartButton" Content="開始" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0" /></StackPanel>
  </Grid>
 </Grid>
</UserControl>
