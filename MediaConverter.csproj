<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MediaConverter</AssemblyName>
    <RootNamespace>MediaConverter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\media-converter.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AppUpdate.Integration" />
    <InternalsVisibleTo Include="Sharing.UIIntegration" />
    <ProjectReference Include="Sharing\EZConverter.Sharing.csproj" />
    <ProjectReference Include="Compression\EZConverter.Compression.csproj" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Compile Remove="work\**\*.cs" />
    <Page Remove="work\**\*.xaml" />
    <Compile Remove="UpdateAgent\**\*.cs" />
    <Compile Remove="Sharing\**\*.cs" />
    <Compile Remove="Compression\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Page Remove="tests\**\*.xaml" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdPartyLicenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Tools\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Condition="'$(SkipBundledTools)' != 'true'" />
    <None Remove="Tools\**\.~lock.*#" />
    <Resource Include="Assets\media-converter.ico" />
    <None Update="Assets\media-converter-icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
